hostname
port 39100
chat true
corpsealivetime 60
timeout 15
maxplayers 60
adminpassword
console false
voicebitrate 60
mapseed
difficulty 0
gamemode
emptybehaviour 1
scriptsautoload true
disablenpcs false
proximityplayers 500000.0
